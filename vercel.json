{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": null,
  "rewrites": [
    { "source": "/api/health", "destination": "/api/health.mjs" },
    { "source": "/api/diag", "destination": "/api/diag.mjs" },
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/((?!assets|favicon\\.ico|.*\\.[a-zA-Z0-9]+$).*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 300
    },
    "api/health.mjs": {
      "maxDuration": 10
    },
    "api/diag.mjs": {
      "maxDuration": 10
    }
  }
}