{
  "name": "ai-slides-generator",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,vite -c magenta,cyan \"npm:dev:server\" \"npm:dev:vite\"",
    "dev:vite": "vite --host 0.0.0.0 --port 5000",
    "dev:server": "node api/index.js",
    "build": "vite build",
    "start": "node api/index.js",
    "preview": "vite preview --host 0.0.0.0 --port 5000"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "concurrently": "^9.2.1",
    "express": "^5.2.1",
    "html2canvas": "^1.4.1",
    "jsonwebtoken": "^9.0.3",
    "jspdf": "^4.2.1",
    "pg": "^8.20.0",
    "pptxgenjs": "^4.0.1",
    "puppeteer": "^24.43.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "vite": "^5.4.21"
  }
}
