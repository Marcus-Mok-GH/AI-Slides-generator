{
  "name": "ai-slides-generator",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,vite -c magenta,cyan \"npm:dev:server\" \"npm:dev:vite\"",
    "db:init": "node scripts/db-init.js",
    "dev:vite": "vite --host 0.0.0.0 --port 5000",
    "dev:server": "node serverless/entry.js",
    "build": "vite build && node scripts/build-api.mjs",
    "start": "node serverless/entry.js",
    "preview": "vite preview --host 0.0.0.0 --port 5000",
    "test": "vitest run",
    "api:build": "node scripts/build-api.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "bcryptjs": "^3.0.3",
    "concurrently": "^9.2.1",
    "express": "^5.2.1",
    "html2canvas": "^1.4.1",
    "jsonwebtoken": "^9.0.3",
    "jspdf": "^4.2.1",
    "pg": "^8.20.0",
    "pptxgenjs": "^4.0.1",
    "puppeteer": "^24.43.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "vite": "^5.4.21",
    "vitest": "^4.1.7",
    "esbuild": "^0.21.5"
  },
  "engines": {
    "node": ">=20.x"
  }
}
